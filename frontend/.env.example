# Frontend Environment Variables (Local Development)
# Copy this file to .env and customize as needed

# Disable ESLint plugin in development
DISABLE_ESLINT_PLUGIN=true
ESLINT_NO_DEV_ERRORS=true

# Build configuration
CI=false
GENERATE_SOURCEMAP=false

# Development server port
PORT=3001

# Backend API URL
# For local development: http://localhost:5001
# For Docker: http://backend:5001
# For production: http://your-server-ip:5001
REACT_APP_URL_API=http://localhost:5001
